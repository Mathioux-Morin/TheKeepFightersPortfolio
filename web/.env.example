# URL of the FastAPI API forwarded by the Nuxt server (see api/README.md).
NUXT_API_URL=http://127.0.0.1:8000

# Nuxt app secret, also used to seal the session cookie (at least 32 characters).
# Optional in development (Nuxt generates one), required in production.
# Generate with: openssl rand -base64 32
NUXT_APP_SECRET=
